const WebSocket = require("ws");
const http = require("http");

const PORT = process.env.PORT || 3000;
const SECRET = "K7vQ9xL2mR8pT4zN6wY3cF1hJ5sD0aE8"; // ← Change this later

const server = http.createServer((req, res) => {
  res.writeHead(200, { "Content-Type": "text/plain" });
  res.end("Control server is running");
});

const wss = new WebSocket.Server({ server });

const clients = new Map();

wss.on("connection", (ws) => {
  let username = null;
  let isMaster = false;

  ws.on("message", (data) => {
    try {
      const msg = JSON.parse(data);

      if (msg.type === "auth") {
        if (msg.secret !== SECRET) {
          ws.close();
          return;
        }

        username = msg.username;
        isMaster = msg.role === "master";
        clients.set(username, ws);

        ws.send(JSON.stringify({ type: "auth_success" }));

        if (isMaster) {
          const list = [...clients.keys()].filter(u => u !== username);
          ws.send(JSON.stringify({ type: "client_list", clients: list }));
        }
        return;
      }

      if (isMaster && msg.type === "command") {
        const target = msg.target;
        const command = msg.command;

        clients.forEach((clientWs, user) => {
          if (user === username) return;
          if (target === "all" || target === user) {
            if (clientWs.readyState === WebSocket.OPEN) {
              clientWs.send(JSON.stringify({
                type: "command",
                command: command
              }));
            }
          }
        });
      }
    } catch (err) {
      console.error(err);
    }
  });

  ws.on("close", () => {
    if (username) {
      clients.delete(username);
    }
  });
});

server.listen(PORT, "0.0.0.0", () => {
  console.log(`Server running on port ${PORT}`);
});
